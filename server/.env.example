# .env.example (server)
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/helploop

# Session secret (min 16 characters)
SESSION_SECRET=your-very-secret-session-key

# Nexconn configuration (required for chat integration)
# Obtain these from the Nexconn developer portal
NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_APP_SECRET=your-nexconn-app-secret
# Optional custom API host (defaults to api.sg-light-api.com)
# NEXCONN_API_HOST=api.sg-light-api.com

