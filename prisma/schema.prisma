generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  HELP_SEEKER
  VOLUNTEER
  BOTH
  ADMIN
}

enum Category {
  EDUCATION
  FOOD
  HEALTHCARE
  TRANSPORTATION
  ELDERLY_CARE
  COMMUNITY_SERVICE
  DIGITAL_ASSISTANCE
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  OPEN
  VOLUNTEER_INTERESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ActivityStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  REQUEST_ASSIGNED
  REQUEST_COMPLETED
  ACTIVITY_JOINED
  ACTIVITY_UPDATE
  SYSTEM
}

enum ReportTarget {
  USER
  REQUEST
  ACTIVITY
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model User {
  id             String     @id @default(cuid())
  nexconnId      String     @unique
  email          String     @unique
  passwordHash   String
  fullName       String
  city           String
  locality       String
  phone          String?
  photoUrl       String?
  role           Role
  introduction   String     @default("")
  interests      String   @default("")
  skills         String   @default("")
  availability   String     @default("")
  suspended      Boolean    @default(false)
  onboardingDone Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  requests             HelpRequest[]        @relation("OwnedRequests")
  offers               VolunteerOffer[]
  seekerConnections    HelpConnection[]     @relation("SeekerConnections")
  volunteerConnections HelpConnection[]     @relation("VolunteerConnections")
  organizedActivities  CommunityActivity[]  @relation("OrganizedActivities")
  participations       ActivityParticipant[]
  notifications        Notification[]
  reportsFiled         Report[]             @relation("ReportsFiled")
  blocksMade           BlockedUser[]        @relation("BlocksMade")
  blocksReceived       BlockedUser[]        @relation("BlocksReceived")
  auditLogs            AuditLog[]

  @@index([city])
  @@index([role])
}

model HelpRequest {
  id             String        @id @default(cuid())
  ownerId        String
  owner          User          @relation("OwnedRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       Category
  location       String
  city           String
  locality       String
  preferredDate  DateTime?
  preferredTime  String?
  urgency        Urgency       @default(MEDIUM)
  volunteerCount Int           @default(1)
  imageUrl       String?
  instructions   String?
  status         RequestStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  offers         VolunteerOffer[]
  connections    HelpConnection[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([city])
  @@index([urgency])
  @@index([createdAt])
}

model VolunteerOffer {
  id          String      @id @default(cuid())
  requestId   String
  request     HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  message     String      @default("")
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  connection  HelpConnection?

  @@unique([requestId, volunteerId])
  @@index([volunteerId])
  @@index([status])
}

model HelpConnection {
  id          String         @id @default(cuid())
  requestId   String
  request     HelpRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerId     String         @unique
  offer       VolunteerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  seekerId    String
  seeker      User           @relation("SeekerConnections", fields: [seekerId], references: [id])
  volunteerId String
  volunteer   User           @relation("VolunteerConnections", fields: [volunteerId], references: [id])
  createdAt   DateTime       @default(now())

  @@unique([requestId, volunteerId])
  @@index([seekerId])
  @@index([volunteerId])
}

model CommunityActivity {
  id              String         @id @default(cuid())
  organizerId     String
  organizer       User           @relation("OrganizedActivities", fields: [organizerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        Category
  location        String
  city            String
  activityDate    DateTime
  activityTime    String
  maxParticipants Int
  status          ActivityStatus @default(UPCOMING)
  nexconnGroupId  String         @unique
  nexconnSynced   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  participants    ActivityParticipant[]

  @@index([city])
  @@index([status])
  @@index([activityDate])
  @@index([organizerId])
}

model ActivityParticipant {
  activityId String
  userId     String
  activity   CommunityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime          @default(now())

  @@id([activityId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetType     ReportTarget
  targetId       String
  reason         String
  details        String       @default("")
  status         ReportStatus @default(OPEN)
  resolutionNote String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model BlockedUser {
  blockerId String
  blockedId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model CommunityStory {
  id         String   @id @default(cuid())
  title      String
  body       String
  authorName String
  approved   Boolean  @default(false)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
