# PostgreSQL connection string. On Replit, put this in Secrets.
DATABASE_URL=postgresql://helploop:helploop@localhost:5432/helploop?schema=public

# Long random string used to sign session cookies. Required.
SESSION_SECRET=replace-with-a-long-random-string

# Server port. Replit sets PORT automatically.
PORT=4000

# Browser origin allowed to call the API during local development.
CLIENT_ORIGIN=http://localhost:5173

# Nexconn Console → Key Management. Server only. Never put the secret in client code.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data-center API host from the Nexconn console. Default matches the official Singapore example.
NEXCONN_API_HOST=api.sg-light-api.com

# Optional. HelpLoop AI assistant stays disabled until this is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
