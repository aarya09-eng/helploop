modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["npm", "start"]
deploymentTarget = "clouovm"

[[ports]]
localPort = 4000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "helploop"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
